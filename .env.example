# GMO Private API (trade = order/cancel/settle + Private WS; readonly = read-only checks)
GMO_API_KEY_TRADE=your_gmo_trade_api_key_here
GMO_API_SECRET_TRADE=your_gmo_trade_api_secret_here
GMO_API_KEY_READONLY=your_gmo_readonly_api_key_here
GMO_API_SECRET_READONLY=your_gmo_readonly_api_secret_here

# X (Twitter) API v2 - OAuth 1.0a User Context (public report auto-post)
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# Internal management Telegram bot (daily report / alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SNS delivery Telegram bot (Instagram/Threads draft text) - MUST differ from above
TELEGRAM_SNS_BOT_TOKEN=
TELEGRAM_SNS_CHAT_ID=

# LLM for SNS commentary (gemini | openai)
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional fallbacks when LLM_API_KEY is empty:
# GEMINI_API_KEY=
# OPENAI_API_KEY=
