[Unit]
Description=BTC trading AI nightly review pipeline
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
TimeoutStartSec=0
WorkingDirectory=/opt/gmo-btc-ws
User=takuya
Group=takuya
# --profile は compose グローバルオプション（run サブコマンドではない）
# 誤配置だと "unknown flag: --profile" で即失敗する（2026-08-03/04）
ExecStart=/usr/bin/docker compose --profile manual run --rm ai_review bash /app/ai_review/run_nightly_review.sh
